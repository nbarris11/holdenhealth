{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/meet-kelsey",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/fitness-coaching",
      "destination": "/fitness-coaching.html",
      "permanent": true
    },
    {
      "source": "/nutrition-coaching",
      "destination": "/nutrition-coaching.html",
      "permanent": true
    },
    {
      "source": "/packages",
      "destination": "/coaching.html",
      "permanent": true
    },
    {
      "source": "/wednesday-reset",
      "destination": "/wednesday-reset.html",
      "permanent": true
    },
    {
      "source": "/wednesday-note",
      "destination": "/wednesday-note.html",
      "permanent": true
    },
    {
      "source": "/contact-1",
      "destination": "/contact.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/custom-page.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
